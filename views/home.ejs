<%- include('partials/header') %>

<section class="hero">
  <div class="notes-fx" aria-hidden="true"><span>♪</span><span>♫</span><span>♪</span><span>♬</span><span>♪</span><span>♫</span></div>
  <div class="hero-inner reveal">
    <p class="eyebrow">Guggamusik aus Partenen · seit <%= s.since %></p>
    <h1>Ore Ore –<br><span class="grad">etz konn d'Latschasorri!</span></h1>
    <p class="hero-sub"><%= texts.homeTitle %></p>
    <% if (texts.homeBody && texts.homeBody.trim()) { %>
    <p class="hero-text"><%- texts.homeBody.split('\n').join('<br>') %></p>
    <% } %>
    <div class="hero-actions">
      <a class="btn primary" href="/termine">🎺 Alle Termine</a>
      <a class="btn ghost" href="/berichte">Neuigkeiten</a>
    </div>
  </div>
</section>

<% if (next) { const d = fmtDatum(next.datum); %>
<section class="nextgig reveal">
  <div class="nextgig-card">
    <div class="ng-date"><span><%= d.tag %></span><strong><%= d.nr %></strong><span><%= d.monat %></span></div>
    <div class="ng-info">
      <p class="ng-label">Nächster Auftritt</p>
      <h3><%= next.titel %> · <%= next.ort %></h3>
      <p><%= next.zeit %></p>
      <p class="countdown" data-date="<%= next.datum %>"></p>
    </div>
  </div>
</section>
<% } %>

<section class="section reveal">
  <div class="sec-head">
    <h2>Frisch berichtet</h2>
    <a class="more" href="/berichte">Alle Berichte →</a>
  </div>
  <div class="cards">
    <% berichte.forEach((b, i) => { const d = fmtDatum(b.datum); %>
    <a class="card post <%= i === 0 ? 'featured' : '' %>" href="/berichte/<%= b.slug %>">
      <% if (b.bild) { %><div class="card-img"><img loading="lazy" src="<%= b.bild %>" alt=""></div><% } %>
      <div class="card-body">
        <time><%= d.lang %></time>
        <h3><%= b.titel %></h3>
        <p><%= b.body.split('\n')[0].slice(0, i === 0 ? 220 : 120) %>…</p>
        <span class="readmore">Weiterlesen →</span>
      </div>
    </a>
    <% }) %>
  </div>
</section>

<section class="section reveal">
  <div class="sec-head">
    <h2>Wir auf Instagram</h2>
  </div>
  <div class="insta-wrap">
    <aside class="insta-side">
      <img class="insta-logo" src="/media/mirror/logo.png" alt="Latschasorri" onerror="this.style.display='none'">
      <h3>@<%= s.instagramHandle %></h3>
      <p class="insta-name">Partener Latschasorri</p>
      <p class="insta-text">Fotos, Videos und G'schichten direkt vom Umzug – folg üs und verpass koan Auftritt!</p>
      <a class="btn primary" href="https://www.instagram.com/<%= s.instagramHandle %>/" target="_blank" rel="noopener">📸 Folgen</a>
      <a class="btn ghost" href="<%= s.youtube %>" target="_blank" rel="noopener">▶ YouTube</a>
    </aside>
    <div class="insta-main">
      <% if (instaPosts && instaPosts.length) { %>
      <!-- Bilder liegen auf Instagram-Servern (Meta) → erst nach Einwilligung „Externe Medien“ laden (FS Consent) -->
      <div class="instagrid" id="igGrid" style="display:none">
        <% instaPosts.forEach(p => { %>
        <a href="<%= p.link %>" target="_blank" rel="noopener">
          <img loading="lazy" data-src="<%= p.img %>" alt="<%= p.caption || 'Instagram-Beitrag' %>">
          <% if (p.video) { %><span class="playicon">▶</span><% } %>
          <% if (p.caption) { %><span class="insta-cap"><%= p.caption %></span><% } %>
        </a>
        <% }) %>
      </div>
      <div class="fsc-ph fsc-ph-other instafeed-ph" id="igPh">
        <div class="fsc-ph-inner">
          <p class="fsc-ph-title">Instagram</p>
          <p class="fsc-ph-text">Hier werden Beiträge von <strong>Instagram</strong> angezeigt. Beim Laden werden Daten wie deine IP-Adresse an Meta übertragen.</p>
          <button type="button" class="fsc-btn fsc-btn-primary" id="igLoad">Beiträge laden</button>
          <label class="fsc-ph-remember"><input type="checkbox" id="igRemember"> Externe Medien immer erlauben</label>
        </div>
      </div>
      <script>
        (function () {
          var grid = document.getElementById('igGrid'), ph = document.getElementById('igPh');
          if (!grid || !ph) return;
          function show() {
            if (grid.style.display !== 'none') return;
            grid.querySelectorAll('img[data-src]').forEach(function (img) { img.src = img.getAttribute('data-src'); img.removeAttribute('data-src'); });
            grid.style.display = '';
            if (ph.parentNode) ph.parentNode.removeChild(ph);
          }
          document.getElementById('igLoad').addEventListener('click', function () {
            if (document.getElementById('igRemember').checked && window.FSConsent) window.FSConsent.allow('media'); else show();
          });
          function check() { if (window.FSConsent && window.FSConsent.has('media')) show(); }
          window.addEventListener('fs-consent:ready', check);
          window.addEventListener('fs-consent:change', check);
          check();
        })();
      </script>
      <% } else { %>
      <div class="instafeed">
        <% if (s.instagramEmbed) { %>
          <%- consentEmbed(s.instagramEmbed) %>
        <% } else { %>
          <iframe data-consent="media" data-service="Instagram" data-src="https://www.instagram.com/<%= s.instagramHandle %>/embed" title="Instagram-Feed von @<%= s.instagramHandle %>" loading="lazy" allowtransparency="true" frameborder="0" scrolling="no"></iframe>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section reveal">
  <div class="sec-head">
    <h2>Aus der Galerie</h2>
    <a class="more" href="/galerie">Zur Galerie →</a>
  </div>
  <div class="masonry small">
    <% galerie.forEach(g => { %>
    <figure class="shot"><img loading="lazy" src="<%= g.bild %>" alt="<%= g.titel %>" data-lightbox></figure>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
